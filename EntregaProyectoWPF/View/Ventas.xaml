<Page x:Class="EntregaProyectoWPF.View.Ventas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EntregaProyectoWPF.View"
      xmlns:vm="clr-namespace:EntregaProyectoWPF.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Ventas">

    <Page.Resources>
        <vm:VentasVM x:Key="VentasVM"/>
    </Page.Resources>

    <Grid DataContext="{StaticResource VentasVM}">
        <Grid HorizontalAlignment="Left" Height="53" VerticalAlignment="Top" Width="800" Background="#2C756C"/>
        <Grid HorizontalAlignment="Left" Height="397" VerticalAlignment="Top" Width="180" Background="#C0FFE1" Margin="0,53,0,0">
            <Button Click="Inicio" Content="Inicio" Margin="10,20,0,0" VerticalAlignment="Top" Width="160" Height="30" BorderThickness="1" Background="#D9D9D9" FontSize="16" HorizontalAlignment="Left"/>
            <Button Click="Trabajador" Content="Trabajadores" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" Width="160" Height="30" BorderThickness="1" Background="#D9D9D9" FontSize="16"/>
            <Button Click="Sellings" Content="Ventas" HorizontalAlignment="Left" Margin="10,120,0,0" VerticalAlignment="Top" Width="160" Height="30" BorderThickness="1" Background="#D9D9D9" FontSize="16"/>
            <Button Click="Almacen" Content="Almacén" HorizontalAlignment="Left" Margin="10,170,0,0" VerticalAlignment="Top" Width="160" Height="30" BorderThickness="1" Background="#D9D9D9" IsCancel="True" FontSize="16"/>
        </Grid>
        <ListView Background="White" Name="AlmacenGrid" Margin="180,53,0,0" ItemsSource="{Binding Ventas}">
            <ListView.View>
                <GridView x:Name="grdTest2">
                    <GridViewColumn Header="IdVenta" DisplayMemberBinding="{Binding IdVenta}" Width="50"/>
                    <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding Fecha}"  Width="135" />
                    <GridViewColumn Header="Importe" DisplayMemberBinding="{Binding Importe}" Width="60" />
                    <GridViewColumn Header="FormaPago" DisplayMemberBinding="{Binding FormaPago}" Width="80" />
                    <GridViewColumn Header="TrabajadorNSS" DisplayMemberBinding="{Binding TrabajadorNSS}" Width="100" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
