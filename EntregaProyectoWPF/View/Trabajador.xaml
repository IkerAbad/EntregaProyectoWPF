<Page x:Class="EntregaProyectoWPF.View.Trabajador"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EntregaProyectoWPF.View"
      xmlns:vm="clr-namespace:EntregaProyectoWPF.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Trabajador">

    <Page.Resources>
        <vm:TrabajadorVM x:Key="TrabajadorVM"/>
    </Page.Resources>

    <Grid DataContext="{StaticResource TrabajadorVM}">

            <Grid HorizontalAlignment="Left" Height="53" VerticalAlignment="Top" Width="800" Background="#2C756C"/>
            <Grid HorizontalAlignment="Left" Height="397" VerticalAlignment="Top" Width="180" Background="#C0FFE1" Margin="0,53,0,0">
                <Button Click="Home" Content="Inicio" Margin="10,20,0,0" VerticalAlignment="Top" Width="160" Height="30" BorderThickness="1" Background="#D9D9D9" FontSize="16" HorizontalAlignment="Left"/>
                <Button Click="Worker" Content="Trabajadores" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" Width="160" Height="30" BorderThickness="1" Background="#D9D9D9" FontSize="16"/>
                <Button Click="Ventas" Content="Ventas" HorizontalAlignment="Left" Margin="10,120,0,0" VerticalAlignment="Top" Width="160" Height="30" BorderThickness="1" Background="#D9D9D9" FontSize="16"/>
                <Button Click="Almacen" Content="Almacén" HorizontalAlignment="Left" Margin="10,170,0,0" VerticalAlignment="Top" Width="160" Height="30" BorderThickness="1" Background="#D9D9D9" IsCancel="True" FontSize="16"/>
            </Grid>
        

        <ListView Background="White" Name="TrabajadorGrid" Margin="180,53,0,0" ItemsSource="{Binding Trabajador}">
            <ListView.View>
                <GridView x:Name="grdTest2">
                    <GridViewColumn Header="NSS" DisplayMemberBinding="{Binding NSS}" Width="80"/>
                    <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Nombre}"  Width="65" />
                    <GridViewColumn Header="Apellido" DisplayMemberBinding="{Binding Apellido}" Width="75" />
                    <GridViewColumn Header="Comision" DisplayMemberBinding="{Binding Comision}" Width="auto" />
                    <GridViewColumn Header="Nº Ventas" DisplayMemberBinding="{Binding NVentas}" Width="auto" />
                    <GridViewColumn Header="Salario Base" DisplayMemberBinding="{Binding SalarioBase}" Width="99" />
                    <GridViewColumn Header="Salario Total" DisplayMemberBinding="{Binding SalarioTotal}" Width="99" />

                </GridView>
            </ListView.View>
        </ListView>
        </Grid>

</Page>
